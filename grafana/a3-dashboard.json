          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (replica_name, status) (rate(http_requests_total{route!=\"/metrics\", status!~\"2..\"}[30s]))",
          "legendFormat": "{{replica_name}} {{status}}",
          "refId": "A"
        }
      ]
    },
